+    Store s(t.path/"db",[&]{return w.now;});Store writer(t.path/"db",[&]{return w.now;});WebService web(s,w,{});
+    const auto marker=identity_marker(s,"a",input.deleted),first=web.read("a",redirect_args());bool erased=false;
