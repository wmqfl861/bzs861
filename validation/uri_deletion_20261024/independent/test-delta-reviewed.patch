+    {"https://cache.example/a/b","https://cache.example/a%2Fb","a"},
+    {"https://cache.example/a%3Bb","https://cache.example/a;b","a"},
+    {"https://cache.example/final?x=a%2Fb","https://cache.example/final?x=a/b","a"}
