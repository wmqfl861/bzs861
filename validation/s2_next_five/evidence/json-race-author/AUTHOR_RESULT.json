  "fix": {
    "scope": "One Json-layer process-lifetime mutex protects shared json-c native access and refcount changes, including cached-buffer serialization until the returned std::string owns its bytes.",
    "covered_operations": [
      "copy get",
      "destructor put",
      "object/array/scalar creation",
      "type and field reads",
      "field/array lookup plus reference retention",
      "str copying",
      "keys iteration plus key copying",
      "set/push get plus implicit release",
      "dump buffer mutation plus result copying"
    ],
    "deadlock_avoidance": "Type helpers finish before entering each narrow native critical section. Factory/accessor returns are C++20 prvalues. Canonicalization composes protected entrypoints rather than holding the same mutex over recursive calls.",
    "lifetime": "The single bounded mutex deliberately lives for the process lifetime so namespace-scope Json destruction cannot use an already-destroyed synchronization object.",
    "contract": "Concurrent readers of otherwise immutable shared JSON trees are supported. Callers still synchronize shared-tree mutation and reassignment of the same Json wrapper; no multi-call snapshot semantics are promised.",
