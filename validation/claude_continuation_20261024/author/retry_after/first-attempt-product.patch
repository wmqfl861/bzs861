+    void repair_source_cooldowns(sqlite3* db,std::int64_t now,const std::string* id=nullptr) {
+      struct Repair { std::string id,error;std::int64_t until; };
+      std::vector<Repair> repairs;
+      {
+        Stmt rows(db,id?
+          "SELECT source_id,last_request_at,last_status,cooldown_until,last_error FROM source_state WHERE source_id=?":
+          "SELECT source_id,last_request_at,last_status,cooldown_until,last_error FROM source_state");
+        if(id)rows.bind(1,*id);
+        while(rows.step()) {
+          // An older late success can hide the original failure kind. Preserve
+          // the existing maximum parse-error backoff (3 x 24h) in that case.
+          // A later 429 can likewise follow a valid 72h parse-error fence.
+          // Without historical failure kinds, only >72h is unambiguously old
+          // invalid state; never shorten a legitimate MAX-combined deadline.
+          if(rows.num(3)<=source_cooldown_until(now,source_retry_after_limit_ms*3))continue;
