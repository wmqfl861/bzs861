+          // when it exists. Reading state again must not renew the cooldown.
+          const auto anchor=rows.num(1)>0?std::min(rows.num(1),now):now;
+          repairs.push_back({rows.text(0),utf8_prefix("E_SOURCE_COOLDOWN_CLAMPED: legacy source deadline exceeded bounded backoff; "+rows.text(4),300),
+                             source_cooldown_until(anchor,maximum)});
+        }
+      }
