{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BZS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "BZS_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-core",
      "configurePreset": "asan",
      "targets": [
        "bzs_tests",
        "bzs_batch_tests",
        "bzs_map_tests",
        "bzs_crawl_tests",
        "bzs_site_publication_tests",
        "bzs_contract_tests",
        "bzs_retention_tests",
        "bzs_fairness_tests",
        "bzs_session_tests",
        "bzs_revalidation_tests",
        "bzs_direct_shared_tests",
        "bzs_capacity_cycles_tests",
        "bzs_revocation_tests",
        "bzs_source_publication_tests",
        "bzs_cache_freshness_tests",
        "bzs_search_mode_tests",
        "bzs_gram_index_tests",
        "bzs_long_document_recall_tests",
        "bzs_background_pool_tests",
        "bzs_receipt_retention_tests",
        "bzs_archive_quota_tests",
        "bzs_incremental_storage_tests",
        "bzs_storage_maintenance_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
